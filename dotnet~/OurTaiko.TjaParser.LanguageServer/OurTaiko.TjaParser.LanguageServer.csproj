<Project Sdk="Microsoft.NET.Sdk">
  <!-- tja-language-server: the Language Server Protocol over stdin and stdout, for VS Code (Editors~/vscode)
       and any editor with an LSP client (Monaco with monaco-languageclient). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>tja-language-server</AssemblyName>
    <RootNamespace>OurTaiko.LanguageServer</RootNamespace>
    <RollForward>Major</RollForward>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../OurTaiko.TjaParser/OurTaiko.TjaParser.csproj" />
  </ItemGroup>
</Project>
